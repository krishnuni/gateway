{
  "name": "gateway-dynamics",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:engine": "node scripts/build-engine.mjs",
    "build": "npm run build:engine && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify-engine.mjs",
    "test:e2e": "playwright test",
    "test:production": "node scripts/test-production.mjs",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "dependencies": {
    "@fontsource/source-sans-3": "^5.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
